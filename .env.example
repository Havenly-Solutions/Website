# Public site URL (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.havenly.solutions

# --- Form delivery (server-side only, never exposed to the browser) ---
# Option A: send every submission to a webhook (for example an n8n workflow).
FORMS_WEBHOOK_URL=
FORMS_WEBHOOK_SECRET=

# Option B: send submissions to the Havenly Solutions backend API.
# POSTs go to {BACKEND_API_URL}/public/pre-registrations, /public/partner-enquiries and /public/contact-messages
BACKEND_API_URL=
BACKEND_API_KEY=
